          "minimum": 32.0,
          "type": "number"
        },
        "wait": {
          "enum": [
            "arc",
            "thin",
            "dots"
          ]
        }
      },
      "type": "object"
    },
    "version": {
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
