  "$id": "https://stillwarddisplay.com/schema/pointer-studio.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "studio.json, beside a set's scheme.json: the set as the studio's sliders, the roles drawn by hand and how each moves. At most 256 KB.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "type": "string"
    },
    "palette": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "accent"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "acc": {
              "description": "A shade of the steel, \"steel:1\" (palest) to \"steel:5\", or \"#rrggbb\".",
              "pattern": "^(steel:[1-5]|#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))$",
              "type": "string"
            },
            "fill": {
              "description": "A shade of the steel, \"steel:1\" (palest) to \"steel:5\", or \"#rrggbb\".",
              "pattern": "^(steel:[1-5]|#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))$",
              "type": "string"
            },
            "kind": {
              "const": "fixed"
            },
            "line": {
              "description": "A shade of the steel, \"steel:1\" (palest) to \"steel:5\", or \"#rrggbb\".",
              "pattern": "^(steel:[1-5]|#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "fill",
            "line",
            "acc"
          ],
          "type": "object"
        }
      ]
    },
    "roles": {
      "additionalProperties": false,
      "properties": {
        "AppStarting": {
          "$ref": "#/$defs/role"
        },
        "Arrow": {
          "$ref": "#/$defs/role"
        },
        "Crosshair": {
          "$ref": "#/$defs/role"
        },
        "Hand": {
          "$ref": "#/$defs/role"
        },
        "Help": {
