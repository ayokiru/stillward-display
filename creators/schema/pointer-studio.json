{
  "$defs": {
    "role": {
      "properties": {
        "built": {
          "type": "string"
        },
        "file": {
          "description": "Its own file in the folder, named for the role: Hand.cur, Wait.ani.",
          "pattern": "^[A-Za-z]+\\.([cC][uU][rR]|[aA][nN][iI]|[iI][cC][oO]|[sS][vV][gG])$",
          "type": "string"
        },
        "from": {
          "enum": [
            "generated",
            "drawn",
            "kept"
          ]
        },
        "hotspot": {
          "items": {
            "maximum": 48.0,
            "minimum": -16.0,
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "motion": {
          "properties": {
            "amount": {
              "description": "Pulse: 0.03 to 0.3 of its size. Sway: 3 to 30 degrees. Blink: 0.2 to 1, how far it fades. Run: 0.5 to 6, a dash's length.",
              "type": "number"
            },
            "kind": {
              "enum": [
                "none",
                "spin",
                "pulse",
                "sway",
                "blink",
                "run"
              ]
            },
            "ms": {
              "maximum": 4000,
              "minimum": 400,
              "type": "integer"
            },
            "part": {
              "type": "string"
            },
            "pivot": {
              "items": {
                "maximum": 48.0,
                "minimum": -16.0,
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "reverse": {
              "type": "boolean"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "shapes": {
          "items": {
            "$ref": "#/$defs/shape"
          },
          "maxItems": 48,
          "type": "array"
        }
      },
      "type": "object"
    },
    "shape": {
      "oneOf": [
        {
          "properties": {
            "cap": {
              "enum": [
                "round",
                "butt",
                "square"
              ]
            },
            "d": {
              "items": {
                "description": "A step of a path, absolute: [\"M\",x,y], [\"L\",x,y], [\"C\",x1,y1,x2,y2,x,y], [\"Q\",x1,y1,x,y] or [\"Z\"].",
                "items": {
                  "maximum": 48.0,
                  "minimum": -16.0,
                  "type": "number"
                },
                "maxItems": 7,
                "prefixItems": [
                  {
                    "enum": [
                      "M",
                      "L",
                      "C",
                      "Q",
                      "Z"
                    ]
                  }
                ],
                "type": "array"
              },
              "maxItems": 200,
              "type": "array"
            },
            "dash": {
              "items": {
                "maximum": 32.0,
                "minimum": 0.0,
                "type": "number"
              },
              "maxItems": 8,
              "type": "array"
            },
            "fill": {
              "description": "One of the set's colours ($fill, $line, $acc), none, or \"#rrggbb\".",
