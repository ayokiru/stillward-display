          "minimum": 6.0,
          "type": "number"
        },
        "scale": {
          "maximum": 1.2000000476837158,
          "minimum": 0.800000011920929,
          "type": "number"
        },
        "shaft": {
          "maximum": 3.200000047683716,
          "minimum": 1.2000000476837158,
          "type": "number"
        },
        "tail": {
          "maximum": 11.0,
          "minimum": 4.0,
          "type": "number"
        },
        "tail_width": {
          "maximum": 5.5,
          "minimum": 2.4000000953674316,
          "type": "number"
        },
        "tip": {
