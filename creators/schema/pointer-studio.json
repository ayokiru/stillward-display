        },
        "UpArrow": {
          "$ref": "#/$defs/role"
        },
        "Wait": {
          "$ref": "#/$defs/role"
        }
      },
      "type": "object"
    },
    "style": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "maximum": 7.0,
          "minimum": 4.5,
          "type": "number"
        },
        "bar": {
