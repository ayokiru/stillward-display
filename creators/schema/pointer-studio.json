              "type": "string"
            },
            "fill_opacity": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "group": {
              "description": "The part it belongs to, which a motion can move. Not \"spin\" or \"frame…\".",
