{
  "$id": "https://stillwarddisplay.com/schema/setup.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A whole desk's look: the items it uses named by Workshop number, and its own places, colours and numbers. Every part is optional. No wallpaper.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "accent": {
      "description": "Windows' accent colour, #rrggbb.",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
    },
    "bar": {
      "description": "The taskbar look.",
      "oneOf": [
        {
          "properties": {
            "ws": {
              "description": "A Workshop item, by its number.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "ws"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "description": "Something the program ships, by its key: windows for Windows' own, none for nothing at all, or a style built into the program. A key of somebody's own library is never carried.",
              "pattern": "^[a-z0-9-]{1,64}$",
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "type": "object"
        }
      ]
    },
    "frame": {
      "description": "The outline round the window in front: on or off, how strong (level), its colour (the program's own, Windows' accent, or own with its #rrggbb) and a shade of it.",
      "properties": {
        "colour": {
          "enum": [
            "brand",
            "windows",
            "own"
          ]
        },
        "level": {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "on": {
          "type": "boolean"
        },
        "own": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "shade": {
          "maximum": 5,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "glass": {
      "description": "The program's glass, from clear (0) to tinted (100).",
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "icons": {
      "description": "The icon set.",
      "oneOf": [
        {
          "properties": {
            "ws": {
              "description": "A Workshop item, by its number.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "ws"
          ],
          "type": "object"
        },
        {
          "properties": {
            "key": {
              "description": "Something the program ships, by its key: windows for Windows' own, none for nothing at all, or a style built into the program. A key of somebody's own library is never carried.",
              "pattern": "^[a-z0-9-]{1,64}$",
              "type": "string"
            }
          },
          "required": [
            "key"
          ],
          "type": "object"
        }
      ]
    },
    "island": {
      "description": "The island: whether it is on, which of its own things it shows (the clock, what is playing, the volume, the calendar), its clock's face, its size, and the activities on it with which look of each. When it steps aside and how it opens stay the person's.",
      "properties": {
        "activities": {
          "items": {
            "properties": {
              "look": {
                "maximum": 3,
                "minimum": 0,
                "type": "integer"
              },
              "ref": {
                "oneOf": [
                  {
                    "properties": {
                      "ws": {
                        "description": "A Workshop item, by its number.",
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "ws"
                    ],
                    "type": "object"
                  },
                  {
                    "properties": {
                      "key": {
                        "description": "Something the program ships, by its key: windows for Windows' own, none for nothing at all, or a style built into the program. A key of somebody's own library is never carried.",
                        "pattern": "^[a-z0-9-]{1,64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "key"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": [
              "ref"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        },
        "calendar": {
          "type": "boolean"
        },
        "clock": {
          "type": "boolean"
        },
        "face": {
          "enum": [
            "off",
            "digital",
            "analog"
          ]
        },
        "media": {
          "type": "boolean"
        },
        "on": {
          "type": "boolean"
        },
        "size": {
          "maximum": 200,
          "minimum": 80,
          "type": "integer"
        },
        "volume": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "motion": {
      "additionalProperties": {
        "oneOf": [
          {
            "properties": {
              "ws": {
                "description": "A Workshop item, by its number.",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "ws"
            ],
            "type": "object"
          },
          {
            "properties": {
              "key": {
                "description": "Something the program ships, by its key: windows for Windows' own, none for nothing at all, or a style built into the program. A key of somebody's own library is never carried.",
                "pattern": "^[a-z0-9-]{1,64}$",
                "type": "string"
              }
            },
            "required": [
              "key"
            ],
            "type": "object"
          }
        ]
      },
      "description": "A window animation style for each moment, by the moment's word.",
      "propertyNames": {
        "enum": [
          "minimize",
          "maximize",
          "drag",
          "resize",
          "snap",
          "monitor",
          "arrange",
          "switch",
          "open-close"
        ]
      },
      "type": "object"
    },
    "name": {
      "description": "What it is called in the library and on the Workshop.",
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "pointer": {
      "description": "The pointer: its set, the set's look (size, tint, edge, shadow, how fast a waiting pointer turns) as the Pointer page writes it, and its effects: a trail, a light round it, sparks, and whether they also show over a window that fills its monitor.",
      "properties": {
        "fx": {
          "properties": {
            "light": {
              "type": "boolean"
            },
            "over_full": {
              "type": "boolean"
            },
            "sparks": {
              "type": "boolean"
            },
            "trail": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "look": {
          "type": "object"
        },
        "set": {
          "oneOf": [
            {
              "properties": {
                "ws": {
                  "description": "A Workshop item, by its number.",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "ws"
              ],
              "type": "object"
            },
            {
              "properties": {
                "key": {
                  "description": "Something the program ships, by its key: windows for Windows' own, none for nothing at all, or a style built into the program. A key of somebody's own library is never carried.",
                  "pattern": "^[a-z0-9-]{1,64}$",
                  "type": "string"
                }
              },
              "required": [
                "key"
              ],
              "type": "object"
            }
          ]
        }
      },
      "type": "object"
    },
    "sounds": {
      "description": "Which of the program's sound families plays for its own moments (ours) and for Windows' sounds (windows). A family's name, never a file.",
      "properties": {
        "ours": {
          "enum": [
            "chimes",
            "chimes-soft",
            "glock",
            "marimba",
            "vibes",
            "pearl"
          ]
        },
        "windows": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "theme": {
      "description": "Light or dark, for Windows and the program.",
      "enum": [
        "light",
        "dark"
      ]
    },
    "version": {
      "description": "The format's version.",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "widgets": {
      "description": "Widgets and where they stand, from a corner of the main monitor's work area, in its logical pixels.",
      "items": {
        "properties": {
          "corner": {
            "enum": [
              "top-left",
              "top-right",
              "bottom-left",
              "bottom-right"
            ]
          },
          "dx": {
            "maximum": 8000.0,
            "minimum": 0,
            "type": "number"
          },
          "dy": {
            "maximum": 8000.0,
            "minimum": 0,
            "type": "number"
          },
          "layer": {
            "enum": [
              "desk",
              "top"
            ]
          },
          "opacity": {
            "maximum": 1.0,
            "minimum": 0.2,
            "type": "number"
          },
          "ref": {
            "oneOf": [
              {
                "properties": {
                  "ws": {
                    "description": "A Workshop item, by its number.",
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "ws"
                ],
                "type": "object"
              },
              {
                "properties": {
                  "key": {
                    "description": "Something the program ships, by its key: windows for Windows' own, none for nothing at all, or a style built into the program. A key of somebody's own library is never carried.",
                    "pattern": "^[a-z0-9-]{1,64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "key"
                ],
                "type": "object"
              }
            ]
          },
          "scale": {
            "maximum": 3.0,
            "minimum": 0.5,
            "type": "number"
          },
          "through": {
            "type": "boolean"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object"
      },
      "maxItems": 48,
      "type": "array"
    }
  },
  "required": [
    "version",
    "name"
  ],
  "title": "Stillward Display setup",
  "type": "object"
}
