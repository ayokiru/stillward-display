{
  "$id": "https://stillwarddisplay.com/schema/widget.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A widget: a card and what is on it. At most 64 KB, 64 items and 8 pictures; pictures are PNG or SVG files in the same folder.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ground": {
      "additionalProperties": false,
      "properties": {
        "edge": {
          "description": "A hairline just inside the card's edge, brighter at the top.",
          "type": "boolean"
        },
        "family": {
          "description": "The family every word of the widget is set in; a line may name its own. One of: segoe (Segoe UI Variable), bahnschrift (Bahnschrift), bahnschrift-narrow (Bahnschrift), montserrat (Montserrat), raleway (Raleway), unbounded (Unbounded), oswald (Oswald), exo (Exo 2), mono (JetBrains Mono), cormorant (Cormorant), comfortaa (Comfortaa), russo (Russo One), wet-paint (Rubik Wet Paint), spray-paint (Rubik Spray Paint), glitch (Rubik Glitch), stalinist (Stalinist One), tektur (Tektur), jura (Jura), rubik-mono (Rubik Mono One).",
          "enum": [
            "segoe",
            "bahnschrift",
            "bahnschrift-narrow",
            "montserrat",
            "raleway",
            "unbounded",
            "oswald",
            "exo",
            "mono",
            "cormorant",
            "comfortaa",
            "russo",
            "wet-paint",
            "spray-paint",
            "glitch",
            "stalinist",
            "tektur",
            "jura",
            "rubik-mono"
          ],
          "type": "string"
        },
        "fill": {
          "description": "A colour word: ink and ink-2 (the card's text, light or dark to suit it), steel or accent with a shade 1 to 5 (lightest to darkest), or #rrggbb; /0.5 after any makes it see-through.",
          "pattern": "^(none|ink|ink-2|steel(:[1-5])?|accent(:[1-5])?|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))(/(0(\\.[0-9]+)?|1(\\.0+)?))?$",
          "type": "string"
        },
        "fill2": {
          "description": "A colour the ground fades to from top to bottom.",
          "pattern": "^(ink|ink-2|steel(:[1-5])?|accent(:[1-5])?|#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))(/(0(\\.[0-9]+)?|1(\\.0+)?))?$",
          "type": "string"
        },
        "opacity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "radius": {
          "maximum": 64,
          "minimum": 0,
          "type": "number"
        },
        "shadow": {
          "description": "A soft shadow under everything drawn, so words with no card under them read on a light wallpaper.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
