      "path": "/bar/main/float",
      "type": "number",
      "min": 0.0,
      "max": 12.0,
      "step": 1.0,
      "unit": "px",
      "default": 4
    },
    {
      "id": "ground",
      "label": {
        "arabic": "الخلفية",
        "brazilian": "Fundo",
        "bulgarian": "Фон",
        "czech": "Pozadí",
        "danish": "Baggrund",
        "dutch": "Achtergrond",
        "english": "Background",
        "finnish": "Tausta",
        "french": "Fond",
