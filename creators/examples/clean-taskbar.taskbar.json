        "polish": "Tło",
        "portuguese": "Fundo",
        "romanian": "Fundal",
        "russian": "Фон",
        "schinese": "背景",
        "spanish": "Fondo",
        "swedish": "Bakgrund",
        "tchinese": "背景",
        "thai": "พื้นหลัง",
        "turkish": "Arka plan",
        "ukrainian": "Тло",
        "vietnamese": "Nền"
